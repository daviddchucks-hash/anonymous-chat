# Copy to .env for local development. On a host like Render, set these in the
# dashboard instead. Never commit a real .env file.

# development | production
NODE_ENV=development
PORT=3000

# Comma-separated list of extra origins allowed to call the API / open a
# WebSocket from a different domain. Leave EMPTY when the frontend and backend
# are served by this same app (the default and recommended setup).
# Example: CORS_ORIGINS=https://chat.example.com,https://www.example.com
CORS_ORIGINS=

# Number of reverse proxies in front of the app (Render = 1, local = 0).
# Used to read the client IP from X-Forwarded-For. Defaults: 1 in production, 0 otherwise.
TRUST_PROXY=

# Secret used to HMAC IP addresses into short opaque tokens for rate limits,
# bans and reports. Raw IPs are never stored. If empty, a random secret is
# generated at every start (bans are then forgotten on restart).
IP_HASH_SECRET=

# Optional: enables the read-only moderation API under /admin/api.
# Must be at least 24 characters. Leave empty to disable the admin API.
ADMIN_TOKEN=

# ---- Limits (defaults shown) ----
MAX_MESSAGE_LENGTH=500
MESSAGE_RATE_MAX=5
MESSAGE_RATE_WINDOW_MS=5000
MAX_CONNECTIONS_PER_IP=5
MAX_ROOM_MESSAGES=300

# ---- Matching ----
# How long a user waits for their chosen interest before being offered "match with anyone".
INTEREST_MATCH_TIMEOUT_MS=15000
# How long a dropped connection may come back (refresh / network blip) before the chat is ended.
RECONNECT_GRACE_MS=20000
# Two users who just talked will not be re-matched for this long.
REMATCH_COOLDOWN_MS=60000
# Set true to stop two users on the same network (same IP) from matching each other.
# Off by default because schools, offices and mobile carriers share IPs.
BLOCK_SAME_IP_MATCH=false

# ---- Moderation ----
ALLOW_LINKS=false
# Extra words to mask, comma-separated.
BLOCKED_WORDS=
STRIKE_LIMIT=8
STRIKE_WINDOW_MS=300000
BAN_DURATION_MS=600000
# Distinct reporters (by network) needed to auto-ban someone temporarily.
REPORT_AUTO_BAN_THRESHOLD=3
# If true, a report includes the reported person's last 5 messages. Default false (data minimisation).
REPORT_INCLUDE_MESSAGES=false
